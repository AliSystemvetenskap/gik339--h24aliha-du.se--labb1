digraph HikeFSM {
  rankdir=LR;
  node [shape=circle, fontname="Arial", fontsize=11, width=1.1, fixedsize=true];
  edge [fontname="Arial", fontsize=9];
  init [shape=point, width=0.15];
  SUMMIT [shape=doublecircle, width=1.0];
  DARK [shape=doublecircle, width=1.0];

  init -> START;
  START -> CLIMB [label="game set up"];
  CLIMB -> CLIMB [label="keep going"];
  CLIMB -> STORM [label="20% chance"];
  CLIMB -> REST [label="energy <= 2"];
  CLIMB -> SUMMIT [label="height >= 100"];
  CLIMB -> DARK [label="hour >= 15"];
  REST -> CLIMB [label="rested"];
  REST -> DARK [label="hour >= 15"];
  STORM -> CLIMB [label="energy > 2"];
  STORM -> REST [label="energy <= 2"];
  STORM -> DARK [label="hour >= 15"];
}
